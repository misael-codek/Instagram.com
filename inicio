<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Cuéntame algo</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #241733;
    --bg-2: #3a2350;
    --card: #2f1e46;
    --coral: #FF6F5E;
    --yellow: #FFC857;
    --lav: #C9AEF2;
    --text: #F6F1FF;
    --muted: #C6B7E0;
    padding-top: env(safe-area-inset-top, 0px);
    padding-bottom: env(safe-area-inset-bottom, 0px);
    box-sizing: border-box;
  }
  html { scroll-padding-top: env(safe-area-inset-top, 0px); }
  * { box-sizing: border-box; }
  html, body { height: 100%; }
  body {
    margin: 0;
    min-height: 100%;
    background: radial-gradient(120% 90% at 50% -10%, var(--bg-2) 0%, var(--bg) 55%);
    color: var(--text);
    font-family: 'Inter', system-ui, sans-serif;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 32px 18px;
    overflow-x: hidden;
    position: relative;
  }

  .floaters { position: fixed; inset: 0; pointer-events: none; overflow: hidden; z-index: 0; }
  .floaters span {
    position: absolute;
    font-size: 28px;
    opacity: 0.35;
    animation: drift 9s ease-in-out infinite;
  }
  .floaters span:nth-child(1) { left: 8%;  top: 12%; animation-delay: 0s; font-size: 34px; }
  .floaters span:nth-child(2) { left: 82%; top: 18%; animation-delay: 1.2s; font-size: 24px; }
  .floaters span:nth-child(3) { left: 15%; top: 78%; animation-delay: 2.1s; font-size: 30px; }
  .floaters span:nth-child(4) { left: 88%; top: 70%; animation-delay: 0.6s; font-size: 26px; }
  .floaters span:nth-child(5) { left: 50%; top: 6%;  animation-delay: 1.8s; font-size: 20px; }
  @keyframes drift {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(-18px) rotate(8deg); }
  }

  .card {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 420px;
    background: linear-gradient(180deg, var(--card), #26173a);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 28px;
    padding: 36px 28px 30px;
    box-shadow: 0 30px 60px rgba(0,0,0,0.45);
    animation: rise 0.7s cubic-bezier(.2,.8,.2,1) both;
  }
  @keyframes rise {
    from { opacity: 0; transform: translateY(24px) scale(0.98); }
    to   { opacity: 1; transform: translateY(0) scale(1); }
  }

  .badge {
    width: 56px; height: 56px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--coral), var(--yellow));
    display: flex; align-items: center; justify-content: center;
    font-size: 26px;
    margin: 0 auto 18px;
    animation: pop 0.6s 0.2s cubic-bezier(.3,1.6,.4,1) both;
  }
  @keyframes pop {
    from { transform: scale(0); }
    to   { transform: scale(1); }
  }

  h1 {
    font-family: 'Baloo 2', sans-serif;
    font-weight: 700;
    font-size: 26px;
    line-height: 1.25;
    text-align: center;
    margin: 0 0 6px;
  }
  .sub {
    text-align: center;
    color: var(--muted);
    font-size: 14.5px;
    margin: 0 0 26px;
    line-height: 1.5;
  }

  label {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 600;
    color: var(--lav);
    margin-bottom: 8px;
  }
  label .ic { font-size: 16px; }

  .field { margin-bottom: 18px; }
  input, textarea {
    width: 100%;
    background: rgba(255,255,255,0.06);
    border: 1.5px solid rgba(255,255,255,0.12);
    border-radius: 14px;
    padding: 13px 14px;
    color: var(--text);
    font-family: 'Inter', sans-serif;
    font-size: 15px;
    outline: none;
    transition: border-color 0.2s, background 0.2s;
    resize: none;
  }
  input::placeholder, textarea::placeholder { color: rgba(246,241,255,0.35); }
  input:focus, textarea:focus {
    border-color: var(--coral);
    background: rgba(255,255,255,0.09);
  }
  textarea { min-height: 84px; }

  button#send {
    width: 100%;
    border: none;
    border-radius: 16px;
    padding: 15px;
    font-family: 'Baloo 2', sans-serif;
    font-size: 17px;
    font-weight: 700;
    color: #2A1638;
    background: linear-gradient(135deg, var(--yellow), var(--coral));
    cursor: pointer;
    margin-top: 4px;
    transition: transform 0.15s ease;
  }
  button#send:active { transform: scale(0.97); }

  .hint {
    text-align: center;
    font-size: 12.5px;
    color: var(--muted);
    margin-top: 14px;
    opacity: 0.8;
  }

  .status {
    display: none;
    text-align: center;
    font-size: 14px;
    color: var(--yellow);
    margin-top: 12px;
    font-weight: 600;
  }

  @media (prefers-reduced-motion: reduce) {
    .card, .badge, .floaters span { animation: none !important; }
  }
</style>
</head>
<body>

<div class="floaters" aria-hidden="true">
  <span>✨</span><span>💌</span><span>🌙</span><span>⭐</span><span>💫</span>
</div>

<div class="card">
  <div class="badge">👋</div>
  <h1>¡Cuéntame algo!</h1>
  <p class="sub">Llena estos dos campos y tu respuesta llega directo a mi correo.</p>

  <form id="surveyForm">
    <div class="field">
      <label for="q1"><span class="ic">🙋</span>¿Cómo te llamas?</label>
      <input id="q1" type="text" placeholder="Tu nombre" required>
    </div>

    <div class="field">
      <label for="q2"><span class="ic">💬</span>¿Qué te gustaría contarme?</label>
      <textarea id="q2" placeholder="Escribe aquí tu mensaje..." required></textarea>
    </div>

    <button id="send" type="submit">Enviar 💌</button>
    <p class="status" id="status">Abriendo tu correo...</p>
    <p class="hint">Se abrirá tu app de correo con el mensaje listo. Solo confirma el envío.</p>
  </form>
</div>

<script>
  const DEST_EMAIL = "fmisaellopez@gmail.com";
  const form = document.getElementById('surveyForm');
  const statusEl = document.getElementById('status');

  form.addEventListener('submit', function (e) {
    e.preventDefault();
    const name = document.getElementById('q1').value.trim();
    const message = document.getElementById('q2').value.trim();
    if (!name || !message) return;

    const subject = "Nueva respuesta de " + name;
    const body =
      "Nombre: " + name + "\n\n" +
      "Mensaje:\n" + message;

    const mailto = "mailto:" + DEST_EMAIL +
      "?subject=" + encodeURIComponent(subject) +
      "&body=" + encodeURIComponent(body);

    statusEl.style.display = 'block';
    window.location.href = mailto;
  });
</script>

</body>
</html>
